# Copy to /srv/ssf/public-testnet.env (0600). Replace placeholders. Never commit the copy.
# Seller keys are read by loadConfig in public-testnet mode.
# PI_TAILNET_IP, REPLICA_TAILNET_IP, WSS_HOSTNAME and SSF_WSS_ORIGIN are deploy/doctor gates.
# Leave WSS_HOSTNAME and SSF_WSS_ORIGIN empty unless an owned delivery node is in use (D1=a).

SSF_MODE=public-testnet
SSF_NETWORK=test
SSF_PUBLIC_ORIGIN=https://store.agentmascot.app
SSF_EMBED_ORIGINS=https://sovereign-store.pages.dev
SSF_MIN_CONFIRMATIONS=3
SSF_MAX_HEALTH_AGE_MS=300000
SSF_MAX_PLAINTEXT_BYTES=8388608
SSF_MAX_CIPHERTEXT_BYTES=8388640
SSF_INVOICE_TTL_MS=86400000
SSF_MAX_OPEN_INVOICES_PER_BUYER=3
SSF_MAX_INVOICES_PER_MINUTE=30
SSF_PUBLIC_HOST=0.0.0.0
SSF_PUBLIC_PORT=8787
SSF_ADMIN_HOST=0.0.0.0
SSF_ADMIN_PORT=8788
SSF_DB_PATH=/var/lib/ssf/seller.sqlite
SSF_ADAPTER_MESSAGING=real
SSF_ADAPTER_STORAGE=real
SSF_ADAPTER_SCANNER=real
SSF_ADMIN_TOKEN_FILE=/var/lib/ssf/admin.token
SSF_SCANNER_SOCKET=/run/ssf/live/scanner.sock
SSF_SCANNER_ACCOUNT_ID=seller-account-0
SSF_SCANNER_CONFIG=/var/lib/ssf/scanner/scanner.json
SSF_WAKU_CONTENT_TOPIC=/ssf/1/public-testnet/proto
WAKU_BOOTSTRAP_PEERS=/dns4/waku.example/tcp/443/wss/p2p/16Uiu2HAmPublicPeerPlaceholder
SSF_WAKU_PEER_TIMEOUT_MS=30000
SSF_WAKU_CLUSTER_ID=
SSF_WAKU_SHARDS=
SSF_SELLER_PUBLIC_KEY=
LOGOSCTL=/opt/logos/squashfs-root/usr/bin/logosctl
LOGOS_NODE_A=/data
LOGOS_NODE_B=/data
SSF_REPLICA_TOKEN_FILE=/var/lib/ssf/replica.token
# Compose injects SSF_REPLICA_AGENT_URL and SSF_LOGOS_ADVERTISE_HOST.
PI_TAILNET_IP=100.64.0.1
REPLICA_TAILNET_IP=100.64.0.2
WSS_HOSTNAME=
SSF_WSS_ORIGIN=
