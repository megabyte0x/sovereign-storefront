{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sovereign Storefront scanner protocol v1 (non-production fixtures)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixturePurpose", "identity", "product", "snapshot", "allocation", "observation", "preparedPackage", "negative"],
  "properties": {
    "version": { "const": 1 },
    "fixturePurpose": { "const": "non-production protocol compatibility vector; contains no wallet material" },
    "identity": { "$ref": "#/$defs/fixtureIdentity" },
    "product": { "$ref": "#/$defs/product" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "allocation": { "$ref": "#/$defs/allocation" },
    "observation": { "$ref": "#/$defs/observation" },
    "preparedPackage": { "$ref": "#/$defs/preparedPackage" },
    "negative": { "$ref": "#/$defs/negative" }
  },
  "x-semanticConstraints": [
    "product.network, snapshot.chain, allocation.chain, and observation.chainNetwork bind to identity",
    "snapshot.accountId, allocation.accountId, receiver.accountId, and receipt.accountId bind to identity.accountId",
    "observation identifies exactly one snapshot receipt by outputId/txid/pool/outputIndex and source/generation",
    "allocation amount equals product amount",
    "snapshot outputId and txid/pool/outputIndex identities are unique",
    "negative candidates must fail their named target validator"
  ],
  "$defs": {
    "network": { "enum": ["test", "regtest"] },
    "id256": { "type": "string", "minLength": 1, "maxLength": 256 },
    "text4096": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receiverHex": { "type": "string", "pattern": "^[0-9a-f]{86}$" },
    "diversifierIndex": { "type": "string", "pattern": "^[0-9a-f]{22}$" },
    "amount": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|1[0-9]{15}|20[0-9]{14}|2100000000000000)$",
      "maxLength": 16,
      "description": "Canonical positive decimal zatoshi through 2100000000000000."
    },
    "uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "chainIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "genesisHash", "consensusFingerprint"],
      "properties": {
        "network": { "$ref": "#/$defs/network" },
        "genesisHash": { "$ref": "#/$defs/hex32" },
        "consensusFingerprint": { "$ref": "#/$defs/hex32" }
      }
    },
    "fixtureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "genesisHash", "consensusFingerprint", "accountId"],
      "properties": {
        "network": { "$ref": "#/$defs/network" },
        "genesisHash": { "$ref": "#/$defs/hex32" },
        "consensusFingerprint": { "$ref": "#/$defs/hex32" },
        "accountId": { "$ref": "#/$defs/id256" }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "scope", "pool", "diversifierIndex", "receiverHex"],
      "properties": {
        "accountId": { "$ref": "#/$defs/id256" },
        "scope": { "const": "external" },
        "pool": { "const": "orchard" },
        "diversifierIndex": { "$ref": "#/$defs/diversifierIndex" },
        "receiverHex": { "$ref": "#/$defs/receiverHex" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "hash"],
      "properties": {
        "height": { "$ref": "#/$defs/uint" },
        "hash": { "$ref": "#/$defs/hex32" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputId", "txid", "pool", "outputIndex", "accountId", "scope", "receiverHex", "amountZat", "firstSeenAt", "mined", "canonical"],
      "properties": {
        "outputId": { "$ref": "#/$defs/id256" },
        "txid": { "$ref": "#/$defs/hex32" },
        "pool": { "const": "orchard" },
        "outputIndex": { "$ref": "#/$defs/uint" },
        "accountId": { "$ref": "#/$defs/id256" },
        "scope": { "enum": ["external", "internal"] },
        "receiverHex": { "$ref": "#/$defs/receiverHex" },
        "amountZat": { "$ref": "#/$defs/amount" },
        "firstSeenAt": { "$ref": "#/$defs/uint" },
        "mined": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }] },
        "canonical": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "x-maxUtf8Bytes": 16777216,
      "required": ["version", "sourceId", "generation", "chain", "accountId", "tip", "scanned", "checkedAt", "caughtUp", "complete", "health", "receipts"],
      "properties": {
        "version": { "const": 1 },
        "sourceId": { "$ref": "#/$defs/id256" },
        "generation": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "accountId": { "$ref": "#/$defs/id256" },
        "tip": { "$ref": "#/$defs/revision" },
        "scanned": { "$ref": "#/$defs/revision" },
        "checkedAt": { "$ref": "#/$defs/uint" },
        "caughtUp": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "health": { "enum": ["ready", "syncing", "unavailable"] },
        "receipts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/receipt" } }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocationId", "chain", "accountId", "amountZat", "expiresAt", "destination", "receiver", "paymentUri"],
      "properties": {
        "allocationId": { "$ref": "#/$defs/id256" },
        "chain": { "$ref": "#/$defs/chainIdentity" },
        "accountId": { "$ref": "#/$defs/id256" },
        "amountZat": { "$ref": "#/$defs/amount" },
        "expiresAt": { "$ref": "#/$defs/uint" },
        "destination": { "$ref": "#/$defs/text4096" },
        "receiver": { "$ref": "#/$defs/receiver" },
        "paymentUri": { "type": "string", "minLength": 6, "maxLength": 4096, "pattern": "^zcash:" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "amountZat", "network", "ciphertextCid", "ciphertextDigest"],
      "properties": {
        "version": { "$ref": "#/$defs/id256" },
        "amountZat": { "$ref": "#/$defs/amount" },
        "network": { "$ref": "#/$defs/network" },
        "ciphertextCid": { "$ref": "#/$defs/text4096" },
        "ciphertextDigest": { "$ref": "#/$defs/hex32" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputId", "sourceId", "generation", "chainNetwork", "txid", "pool", "outputIndex"],
      "properties": {
        "outputId": { "$ref": "#/$defs/id256" },
        "sourceId": { "$ref": "#/$defs/id256" },
        "generation": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 },
        "chainNetwork": { "$ref": "#/$defs/network" },
        "txid": { "$ref": "#/$defs/hex32" },
        "pool": { "const": "orchard" },
        "outputIndex": { "$ref": "#/$defs/uint" }
      }
    },
    "preparedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "productVersion", "buyerKeyId", "packageId", "encryptedEnvelopeBytes"],
      "properties": {
        "orderId": { "$ref": "#/$defs/id256" },
        "productVersion": { "$ref": "#/$defs/id256" },
        "buyerKeyId": { "$ref": "#/$defs/id256" },
        "packageId": { "$ref": "#/$defs/hex32" },
        "encryptedEnvelopeBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "negativeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "candidate"],
      "properties": {
        "name": { "$ref": "#/$defs/id256" },
        "candidate": { "type": "object", "minProperties": 1 }
      }
    },
    "negative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshots", "allocations", "vectors"],
      "properties": {
        "snapshots": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/negativeCase" } },
        "allocations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/negativeCase" } },
        "vectors": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/negativeCase" } }
      }
    }
  }
}
